# Copy to .env. Vite exposes ONLY variables prefixed VITE_ to the browser.
#
# Everything here ships to the client in the built bundle. Never put the
# service_role key in this file — it bypasses row-level security entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# FastAPI backend. Local in dev, the Render URL in production.
VITE_API_URL=http://localhost:8000
