# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ── Groq ──────────────────────────────────────────────────
# https://console.groq.com/keys — key starts gsk_
#
# THE ONLY LLM PROVIDER. The NVIDIA NIM block that used to sit above this one
# was deleted on 2026-08-04: `config.py`'s REQUIRED_VARS stopped naming any
# NVIDIA_* var on 2026-07-31, so it had been documentation for variables no
# code reads. It was not harmless — the deployed Render service was still
# holding the NVIDIA set, its 2026-07-31 auto-deploy died at startup on
# ConfigError, and Render kept serving the last healthy build. The result was a
# production backend stuck on Phase 0's routes for four days, returning 404
# `Not Found` to every upload. See DEV-STATE § Decisions 2026-08-04.
#
# Migration reason, kept because it still governs model choice: structured
# output on NVIDIA returns None once the system prompt passes roughly
# 1500-2800 characters, on all three of its models, which is the shape every
# agent uses. See DEV-STATE § Decisions 2026-07-31.
#
# OpenAI-compatible, so ChatOpenAI(base_url=...) works with no vendor package.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Only `openai/gpt-oss-*` accept a strict JSON schema on Groq. Llama, Qwen and
# Compound return 400 `This model does not support response format`, which is
# the shape every agent needs. That is what pins these two.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_DEEP=openai/gpt-oss-120b
GROQ_MODEL_BACKUP=llama-3.3-70b-versatile

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string
#
# CRITICAL: use the SESSION POOLER on port 5432.
#   ✅ postgresql://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
#   ❌ db.<ref>.supabase.co:5432        — IPv6-only, unreachable from Render free tier
#   ❌ ...pooler.supabase.com:6543      — transaction mode, breaks prepared statements
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────
# ON RENDER this must include the deployed Netlify origin, not localhost, or
# every browser request fails CORS after the deploy finally succeeds:
#   ALLOWED_ORIGINS=https://pmaiinterviewpanel.netlify.app
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
