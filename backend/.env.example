# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ── NVIDIA NIM ────────────────────────────────────────────
# https://build.nvidia.com/nvidia/nemotron-3-super-120b-a12b → Generate API Key
# Account-wide, not model-scoped. Free tier: up to 40 requests/minute, no credits.
#
# Three models, not one — GLM 5.2 queues ~230s on the free tier (per-model demand,
# not an account throttle) and is out. `thinking` was GLM-only and does not exist
# on Nemotron; model choice is the latency lever instead. See DEV-STATE 2026-07-29.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_BACKUP=openai/gpt-oss-20b

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string
#
# CRITICAL: use the SESSION POOLER on port 5432.
#   ✅ postgresql://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
#   ❌ db.<ref>.supabase.co:5432        — IPv6-only, unreachable from Render free tier
#   ❌ ...pooler.supabase.com:6543      — transaction mode, breaks prepared statements
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
