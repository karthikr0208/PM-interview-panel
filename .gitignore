*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ── Node / frontend ───────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Editors & OS ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

