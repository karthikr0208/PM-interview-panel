# ── Secrets — never commit ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ── Node / frontend ───────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Editors & OS ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Installed skills (restore with: npx skills add …) ─────
.agents/
.claude/skills/
skills-lock.json

# ── Plugin auto-checkpoints, not this project's handoff ───
# GSD writes empty HANDOFF.json files on a post-tool hook. docs/DEV-STATE.md
# is the handoff. Tracking these adds churn and invites a future session to
# open a file named HANDOFF and find nothing in it.
.planning/
